,\n        mobileOpen,\n        openMobile,\n        closeMobile,\n        expandedChats,\n        toggleChat,\n        expandChats,\n      }}\n    >\n      {children}\n    </SidebarContext.Provider>\n  );\n}\n","exit_code":0,"status":"completed"}}
