{"type":"item.completed","item":{"id":"item_19","type":"command_execution","command":"/usr/bin/zsh -lc \"sed -n '1,180p' src/components/sidebar/sidebar-context.tsx\"","aggregated_output":"\"use client\";\n\nimport {\n  createContext,\n  useCallback,\n  useContext,\n  useEffect,\n  useState,\n  type ReactNode,\n} from \"react\";\n\ninterface SidebarContextValue {\n  collapsed: boolean;\n  mobileOpen: boolean;\n  toggleSidebar: () => void;\n  closeMobile: () => void;\n  openMobile: () => void;\n  expandedChats: Set<string>;\n  toggleChat: (id: string) => void;\n  expandChats: (ids: string[]) => void;\n}\n\nexport const SIDEBAR_MOBILE_TOGGLE_ID = \"sidebar-mobile-toggle\";\n\nconst SidebarContext = createContext<SidebarContextValue | null>(null);\n\nexport function useSidebar() {\n  const ctx = useContext(SidebarContext);\n  if (!ctx) throw new Error(\"useSidebar must be used within SidebarProvider\");\n  return ctx;\n}\n\nexport function SidebarProvider({ children }: { children: ReactNode }) {\n  const [collapsed, setCollapsed] = useState(false);\n  const [mobileOpen, setMobileOpen] = useState(false);\n  const [expandedChats, setExpandedChats] = useState<Set<string>>(new Set());\n\n  const toggleSidebar = useCallback(() => {\n    setCollapsed((prev) => !prev);\n  }, []);\n\n  const openMobile = useCallback(() => {\n    setMobileOpen(true);\n  }, []);\n\n  const closeMobile = useCallback(() => {\n    setMobileOpen(false);\n  }, []);\n\n  useEffect(() => {\n    if (typeof window === \"undefined\") return;\n    const media = window.matchMedia(\"(max-width: 767px)\");\n    const handleChange = (event: MediaQueryListEvent) => {\n      if (event.matches) {\n        setMobileOpen(false);\n      }\n    };\n    if (media.matches) {\n      setMobileOpen(false);\n    }\n    if (\"addEventListener\" in media) {\n      media.addEventListener(\"change\", handleChange);\n      return () => {\n        media.removeEventListener(\"change\", handleChange);\n      };\n    }\n    media.addListener(handleChange);\n    return () => {\n      media.removeListener(handleChange);\n    };\n  }, []);\n\n  const toggleChat = useCallback((id: string) => {\n    setExpandedChats((prev) => {\n      const next = new Set(prev);\n      if (next.has(id)) {\n        next.delete(id);\n      } else {\n        next.add(id);\n      }\n      return next;\n    });\n  }, []);\n\n  const expandChats = useCallback((ids: string[]) => {\n    if (ids.length === 0) return;\n    setExpandedChats((prev) => {\n      const next = new Set(prev);\n      for (const id of ids) {\n        next.add(id);\n      }\n      return next;\n    });\n  }, []);\n\n  return (\n    <SidebarContext.Provider\n      value={{\n        collapsed,\n        mobileOpen,\n        toggleSidebar,\n        closeMobile,\n        openMobile,\n        expandedChats,\n        toggleChat,\n        expandChats,\n      }}\n    >\n      {children}\n    </SidebarContext.Provider>\n  );\n}\n","exit_code":0,"status":"completed"}}
