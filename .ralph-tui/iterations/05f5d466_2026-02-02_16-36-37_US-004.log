tline-none has-[textarea:focus-visible]:ring-2 data-[dragging=true]:border-dashed\",\n          compactMobile && \"group/compose\"\n        )}\n      >\n        <ComposerAttachments />\n        <div className=\"relative\">\n          <ComposerPrimitive.Input\n            placeholder=\"Send a message...\"\n            className={cn(\n              \"aui-composer-input placeholder:text-muted-foreground mb-1 max-h-32 min-h-10 w-full resize-none overflow-y-auto bg-transparent px-4 py-2 text-base outline-none focus-visible:ring-0 md:min-h-14 md:pt-2 md:pb-3 md:text-sm\",\n              compactMobile && \"pr-12 md:pr-4\"\n            )}\n            rows={1}\n            autoFocus={!compactMobile}\n            aria-label=\"Message input\"\n            ref={inputRef}\n          />\n          {compactMobile ? <ComposerCompactAction /> : null}\n        </div>\n        <ComposerAction compactMobile={compactMobile} />\n      </ComposerPrimitive.AttachmentDropzone>\n    </ComposerPrimitive.Root>\n  );\n};\n\nconst ComposerCompactAction: FC = () => {\n  return (\n    <div className=\"absolute right-2 top-1/2 -translate-y-1/2 md:hidden group-focus-within/compose:hidden\">\n      <AuiIf condition={({ thread }) => !thread.isRunning}>\n        <ComposerSendButton />\n      </AuiIf>\n      <AuiIf condition={({ thread }) => thread.isRunning}>\n        <ComposerCancelButton />\n      </AuiIf>\n    </div>\n  );\n};\n\nconst ComposerSendButton: FC = () => {\n  return (\n    <ComposerPrimitive.Send asChild>\n      <TooltipIconButton\n        tooltip=\"Send message\"\n        side=\"bottom\"\n        type=\"submit\"\n        variant=\"default\"\n        size=\"icon\"\n        className=\"aui-composer-send size-8 rounded-full\"\n        aria-label=\"Send message\"\n      >\n        <ArrowUpIcon className=\"aui-composer-send-icon size-4\" />\n      </TooltipIconButton>\n    </ComposerPrimitive.Send>\n  );\n};\n\nconst ComposerCancelButton: FC = () => {\n  return (\n    <ComposerPrimitive.Cancel asChild>\n      <Button\n        type=\"button\"\n        variant=\"default\"\n        size=\"icon\"\n        className=\"aui-composer-cancel size-8 rounded-full\"\n        aria-label=\"Stop generating\"\n      >\n        <SquareIcon className=\"aui-composer-cancel-icon size-3 fill-current\" />\n      </Button>\n    </ComposerPrimitive.Cancel>\n  );\n};\n\nconst ComposerAction: FC<{ compactMobile?: boolean }> = ({\n  compactMobile = false,\n}) => {\n  return (\n    <div\n      className={cn(\n        \"aui-composer-action-wrapper relative mx-2 mb-2 flex items-center justify-between\",\n        compactMobile && \"hidden md:flex group-focus-within/compose:flex\"\n      )}\n    >\n      <ComposerAddAttachment />\n      <AuiIf condition={({ thread }) => !thread.isRunning}>\n        <ComposerSendButton />\n      </AuiIf>\n      <AuiIf condition={({ thread }) => thread.isRunning}>\n        <ComposerCancelButton />\n      </AuiIf>\n    </div>\n  );\n};\n\nconst MessageError: FC = () => {\n  return (\n    <MessagePrimitive.Error>\n      <ErrorPrimitive.Root className=\"aui-message-error-root border-destructive bg-destructive/10 text-destructive dark:bg-destructive/5 mt-2 rounded-md border p-3 text-sm dark:text-red-200\">\n        <ErrorPrimitive.Message className=\"aui-message-error-message line-clamp-2\" />\n      </ErrorPrimitive.Root>\n    </MessagePrimitive.Error>\n  );\n};\n\nconst AssistantMessage: FC = () => {\n  return (\n    <MessagePrimitive.Root\n      className=\"aui-assistant-message-root fade-in slide-in-from-bottom-1 animate-in relative mx-auto w-full max-w-(--thread-max-width) py-3 duration-150\"\n      data-role=\"assistant\"\n    >\n      <div className=\"aui-assistant-message-content text-foreground px-2 leading-relaxed wrap-break-word\">\n        <MessagePrimitive.Parts\n          components={{\n            Text: MarkdownText,\n            Reasoning,\n            ReasoningGroup,\n            tools: { Fallback: ToolFallback },\n          }}\n        /